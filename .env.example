# Copy this file's keys into the Vercel dashboard → Project Settings → Environment Variables

# Flask secret key (change this to a random string)
SECRET_KEY=change_this_to_a_random_secret

# Your cloud MySQL database URL
# Format: mysql+pymysql://username:password@host:port/database_name
DATABASE_URL=mysql+pymysql://user:password@your-host:3306/campus_events_db

# Gmail credentials for sending emails
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
